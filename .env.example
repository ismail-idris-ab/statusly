# Statusly environment variables (Doc 02 — TRD).
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit secrets.
# In dev, AdMob uses Google's official TEST unit IDs regardless of these (see src/features/ads).

# AdMob — real IDs are only wired at build time (Phase 9).
ADMOB_ANDROID_APP_ID=
ADMOB_BANNER_UNIT_ID=
ADMOB_INTERSTITIAL_UNIT_ID=
ADMOB_APPOPEN_UNIT_ID=
ADMOB_NATIVE_UNIT_ID=

# IAP
IAP_REMOVE_ADS_SKU=remove_ads

# Crash reporting (Phase 1 wiring is no-op until this is set)
SENTRY_DSN=
